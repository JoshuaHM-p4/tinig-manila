  "egovph_info": {
    "about": "Ang eGovPH ay ang opisyal na Super App ng pamahalaan ng Pilipinas na nagbibigay ng access sa mahigit 70 serbisyong pang-gobyerno sa iisang platform.",
    "how_to_register": [
      "I-download ang eGovPH app sa Google Play Store o Apple App Store.",
      "Mag-sign up gamit ang inyong email address o mobile number.",
      "I-verify ang inyong pagkakakilanlan gamit ang inyong PSA Birth Certificate o valid ID.",
      "Kumpletuhin ang inyong profile at i-link ang inyong mga government IDs.",
      "Maaari na kayong gumamit ng inyong eGovPH account para sa lahat ng serbisyo."
    ],
    "available_services_count": 70,
    "key_services": [
      "SSS – Social Security Records",
      "PhilHealth – Health Insurance",
      "Pag-IBIG – Housing Fund",
      "DFA – Passport Application",
      "LTO – Driver's License",
      "BIR – Tax Records",
      "DSWD – Social Welfare Benefits",
      "DOH – Health Services",
      "CHED – Educational Records",
      "NBI Clearance",
      "PNP – Police Clearance",
      "PSA – Civil Registry (Birth/Marriage/Death Certificates)",
      "Senior Citizen Benefits (OSCA)"
    ],
    "hotline": "1-888 (eGovPH Help Desk)",
    "website": "https://egovph.gov.ph",
    "for_seniors_note": "Para sa mga hindi makapag-download ng app, ang Tinig Manila ay narito upang tulungan kayong ma-access ang inyong eGovPH account at serbisyo sa pamamagitan lamang ng isang tawag."
  }
}
