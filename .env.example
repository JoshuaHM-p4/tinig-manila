# ─────────────────────────────────────────────────────────────
# TINIG MANILA — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Groq AI (FREE) ────────────────────────────────────────────
# Sign up at https://console.groq.com
# Free tier: 14,400 requests/day, 30,000 tokens/min — more than enough for a hackathon.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (FREE trial, ~$15.50 credit) ──────────────────────
# Sign up at https://twilio.com
# Get your Account SID and Auth Token from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number (assigned after sign-up).
# Format: +1XXXXXXXXXX (US toll-free) or +63XXXXXXXXXX (PH number)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Server ────────────────────────────────────────────────────
PORT=3000
