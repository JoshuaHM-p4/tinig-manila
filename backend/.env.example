# ─────────────────────────────────────────────────────────────
# TINIG MANILA — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Groq AI (FREE) ────────────────────────────────────────────
# Sign up at https://console.groq.com
# Free tier: 14,400 requests/day, 30,000 tokens/min.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (FREE trial, ~$15.50 credit) ──────────────────────
# Sign up at https://twilio.com
# Get Account SID + Auth Token from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number (assigned after sign-up).
# Format: +1XXXXXXXXXX (US) or +63XXXXXXXXXX (PH)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Server ────────────────────────────────────────────────────
PORT=3000

# Host to bind to. Default is 0.0.0.0 so the server is reachable from
# inside containers / PaaS runtimes (Render, Fly, Heroku, Railway, K8s).
# Override to 127.0.0.1 for local-only development.
HOST=0.0.0.0

# NODE_ENV controls a few things:
#   - 'production' → optimised Express, stricter error handling
#   - 'test'       → voice/security.js skips Twilio signature validation
NODE_ENV=development

# ── Twilio webhook signature validation ───────────────────────
# Every /twilio/* route validates the X-Twilio-Signature header using
# TWILIO_AUTH_TOKEN. Set to 'false' ONLY for local dev when you're
# hitting the endpoints with curl/Postman. NEVER set this in production.
TWILIO_VALIDATE=true

# ── Local dev escape hatch (OPTIONAL) ─────────────────────────
# Set to "true" only if your local network performs SSL interception
# (corporate/campus proxies) and Groq/Twilio HTTPS calls fail with
# UNABLE_TO_VERIFY_LEAF_SIGNATURE. Force-disabled when NODE_ENV=production.
# Leave commented out in normal use.
# ALLOW_INSECURE_TLS=true
